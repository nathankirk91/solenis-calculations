# Supabase Postgres via Prisma
# Get both URLs from: Supabase Dashboard → Project Settings → Database

# Pooled connection (Transaction mode / port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / session connection (port 5432) — used by Prisma Migrate / Studio
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Cookie session signing secret (generate a long random string)
SESSION_SECRET="replace-with-a-long-random-secret"

# Seed accounts for `npm run db:seed`
# Admin (one person) — also accepts legacy SEED_USER_* names
SEED_ADMIN_EMAIL="admin@solenis.local"
SEED_ADMIN_PASSWORD="changeme"

# Shared plant-floor operator login
SEED_OPERATOR_EMAIL="operator@solenis.local"
SEED_OPERATOR_PASSWORD="changeme"

# Optional personal manager account
# SEED_MANAGER_EMAIL="manager@company.com"
# SEED_MANAGER_PASSWORD="changeme"
# SEED_MANAGER_NAME="Site Manager"

# Canonical site URL used in push notification deep links
APP_BASE_URL="https://solenis-calculations.vercel.app"

# Web Push (VAPID) for manager phone notifications
# Generate with: npx web-push generate-vapid-keys --json
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:you@company.com"
