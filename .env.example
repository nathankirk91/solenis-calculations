# Supabase Postgres via Prisma
# Get both URLs from: Supabase Dashboard → Project Settings → Database

# Pooled connection (Transaction mode / port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / session connection (port 5432) — used by Prisma Migrate / Studio
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Cookie session signing secret (generate a long random string)
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional seed credentials for `npm run db:seed`
SEED_USER_EMAIL="admin@solenis.local"
SEED_USER_PASSWORD="changeme"
