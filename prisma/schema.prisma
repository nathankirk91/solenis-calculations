// Prisma schema for Hercules 1612 (Supabase Postgres)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OPERATOR
  MANAGER
  ADMIN

  @@map("user_role")
}

enum CalculationRunStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("calculation_run_status")
}

enum InspectionRunStatus {
  PASSED
  NEEDS_ATTENTION

  @@map("inspection_run_status")
}

enum InspectionActionStatus {
  OPEN
  CLOSED

  @@map("inspection_action_status")
}

enum InspectionQuestionType {
  YES_NO
  TEXT
  RADIO
  NUMBER
  DATE
  TIME
  CHECKBOX

  @@map("inspection_question_type")
}

enum PermitRunStatus {
  PENDING_AUTHORIZATION
  OPEN
  CLOSED

  @@map("permit_run_status")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  /// Primary system access role (synced from Admin/Manager/Operator assignments).
  role         UserRole @default(OPERATOR)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  submittedRuns              CalculationRun[]  @relation("SubmittedBy")
  reviewedRuns               CalculationRun[]  @relation("ReviewedBy")
  operatorCalculationRuns    CalculationRun[]  @relation("CalculationOperator")
  submittedInspectionRuns    InspectionRun[]   @relation("InspectionSubmittedBy")
  operatorInspectionRuns     InspectionRun[]   @relation("InspectionOperator")
  submittedPermitRuns        PermitRun[]       @relation("PermitSubmittedBy")
  closedPermitRuns           PermitRun[]       @relation("PermitClosedBy")
  inspectionVersions         InspectionVersion[] @relation("InspectionVersionChangedBy")
  createdInspectionActions   InspectionAction[] @relation("InspectionActionCreatedBy")
  closedInspectionActions    InspectionAction[] @relation("InspectionActionClosedBy")
  pushSubscriptions          PushSubscription[]
  notificationPreferences    UserNotificationPreference[]
  roleAssignments            UserRoleAssignment[]
  assignedRolesBy            UserRoleAssignment[] @relation("RoleAssignedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  /// Built-in roles (admin/manager/operator + default permit roles) cannot be deleted.
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users              UserRoleAssignment[]
  permitSignOffSlots PermitSignOffSlotRole[]

  @@index([isActive, sortOrder])
  @@map("roles")
}

model UserRoleAssignment {
  userId       String   @map("user_id")
  roleId       String   @map("role_id")
  assignedById String?  @map("assigned_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

/// Which app roles may sign each permit authorization slot.
model PermitSignOffSlot {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  allowedRoles PermitSignOffSlotRole[]

  @@index([sortOrder])
  @@map("permit_sign_off_slots")
}

model PermitSignOffSlotRole {
  slotId String @map("slot_id")
  roleId String @map("role_id")

  slot PermitSignOffSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  role Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([slotId, roleId])
  @@index([roleId])
  @@map("permit_sign_off_slot_roles")
}


model Calculation {
  id          String   @id
  slug        String   @unique
  title       String
  description String
  category    String   @default("general")
  href        String
  isAvailable Boolean  @default(true) @map("is_available")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  runs        CalculationRun[]

  @@map("calculations")
}

model CalculationRun {
  id               String                @id @default(cuid())
  calculationId    String                @map("calculation_id")
  calculation      Calculation           @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  operatorUserId   String?               @map("operator_user_id")
  operatorUser     User?                 @relation("CalculationOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  submittedById    String?               @map("submitted_by_id")
  submittedBy      User?                 @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  status           CalculationRunStatus  @default(PENDING)
  inputs           Json
  outputs          Json
  reviewedById     String?               @map("reviewed_by_id")
  reviewedBy       User?                 @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  reviewNote       String?               @map("review_note")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([calculationId])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("calculation_runs")
}

model Inspection {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  title                String
  description          String   @default("")
  category             String   @default("general")
  href                 String
  equipmentLabel       String?  @map("equipment_label")
  /// For permit forms: how many distinct authorisation signatures open the permit (2 or 3).
  requiredSignerCount  Int?     @map("required_signer_count")
  /// When set, this form inherits questions from the template inspection.
  templateInspectionId String?  @map("template_inspection_id")
  template             Inspection?  @relation("InspectionTemplate", fields: [templateInspectionId], references: [id], onDelete: Restrict)
  unitForms            Inspection[] @relation("InspectionTemplate")
  /// Locked equipment unit for child forms (e.g. forklift H57168).
  fixedEquipmentRef    String?  @map("fixed_equipment_ref")
  isAvailable          Boolean  @default(true) @map("is_available")
  sortOrder            Int      @default(0) @map("sort_order")
  version              Int      @default(1)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  runs                 InspectionRun[]
  questions            InspectionQuestion[]
  versions             InspectionVersion[]
  actions              InspectionAction[]
  permitRuns           PermitRun[]

  @@index([templateInspectionId])
  @@map("inspections")
}

model InspectionVersion {
  id            String     @id @default(cuid())
  inspectionId  String     @map("inspection_id")
  inspection    Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  version       Int
  changeComment String     @map("change_comment")
  changedById   String?    @map("changed_by_id")
  changedBy     User?      @relation("InspectionVersionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  snapshot      Json
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([inspectionId, version])
  @@index([inspectionId, createdAt(sort: Desc)])
  @@map("inspection_versions")
}

model InspectionQuestion {
  id              String                  @id @default(cuid())
  inspectionId    String                  @map("inspection_id")
  inspection      Inspection              @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  label           String
  helpText        String?                 @map("help_text")
  sectionTitle    String?                 @map("section_title")
  type            InspectionQuestionType
  options         Json?
  attentionValues Json?                   @map("attention_values")
  required        Boolean                 @default(true)
  /// When true, operators see the prior report's answer for this question.
  showLastValue   Boolean                 @default(false) @map("show_last_value")
  /// Unit refs this question applies to; null/empty = all inheriting units.
  applicableEquipmentRefs Json?           @map("applicable_equipment_refs")
  /// Shift labels this question applies to (e.g. Day); null/empty = all shifts.
  applicableShifts Json?                  @map("applicable_shifts")
  /// When true, only show on the first matching inspection of the Mon–Sun week.
  firstOfWeekOnly Boolean                 @default(false) @map("first_of_week_only")
  /// Permit semantics: start_time | end_time | area (null for ordinary checklist items).
  permitFieldRole String?                 @map("permit_field_role")
  isActive        Boolean                 @default(true) @map("is_active")
  sortOrder       Int                     @default(0) @map("sort_order")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([inspectionId, isActive, sortOrder])
  @@map("inspection_questions")
}

model InspectionRun {
  id                 String               @id @default(cuid())
  inspectionId       String               @map("inspection_id")
  inspection         Inspection           @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  operatorUserId     String?              @map("operator_user_id")
  operatorUser       User?                @relation("InspectionOperator", fields: [operatorUserId], references: [id], onDelete: SetNull)
  submittedById      String?              @map("submitted_by_id")
  submittedBy        User?                @relation("InspectionSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  status             InspectionRunStatus
  equipmentRef       String?              @map("equipment_ref")
  inspectionVersion  Int?                 @map("inspection_version")
  responses          Json
  summary            Json
  notes              String?
  signature          String?
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  actions            InspectionAction[]   @relation("ActionsCreatedOnRun")

  @@index([inspectionId])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("inspection_runs")
}

model InspectionAction {
  id                  String                 @id @default(cuid())
  createdOnRunId      String                 @map("created_on_run_id")
  createdOnRun        InspectionRun          @relation("ActionsCreatedOnRun", fields: [createdOnRunId], references: [id], onDelete: Cascade)
  inspectionId        String                 @map("inspection_id")
  inspection          Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  /// Unit scope for carry-forward (e.g. forklift H57168).
  equipmentRef        String?                @map("equipment_ref")
  description         String
  status              InspectionActionStatus @default(OPEN)
  createdByUserId     String?                @map("created_by_user_id")
  createdByUser       User?                  @relation("InspectionActionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  closedAt            DateTime?              @map("closed_at") @db.Timestamptz(6)
  closedById          String?                @map("closed_by_id")
  closedBy            User?                  @relation("InspectionActionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  completionComment   String?                @map("completion_comment")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, equipmentRef, createdAt(sort: Desc)])
  @@index([status, inspectionId, createdAt(sort: Desc)])
  @@index([createdOnRunId])
  @@map("inspection_actions")
}

model PermitNumberSequence {
  yearMonth String   @id @map("year_month")
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("permit_number_sequences")
}

model PermitRun {
  id                  String          @id @default(cuid())
  permitNumber        String?         @unique @map("permit_number")
  inspectionId        String          @map("inspection_id")
  inspection          Inspection      @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  submittedById       String?         @map("submitted_by_id")
  submittedBy         User?           @relation("PermitSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  status              PermitRunStatus @default(OPEN)
  equipmentRef        String?         @map("equipment_ref")
  inspectionVersion   Int?            @map("inspection_version")
  responses           Json
  summary             Json
  authorizedPersonnel Json            @map("authorized_personnel")
  authorization       Json
  closeout            Json?
  closedAt            DateTime?       @map("closed_at") @db.Timestamptz(6)
  closedById          String?         @map("closed_by_id")
  closedBy            User?           @relation("PermitClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([inspectionId])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("permit_runs")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Per-user opt-in for each push event type. Missing rows mean enabled.
model UserNotificationPreference {
  userId    String   @map("user_id")
  type      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@index([type, enabled])
  @@map("user_notification_preferences")
}
